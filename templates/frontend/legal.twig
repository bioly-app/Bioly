{% extends 'frontend/base.twig' %}

{% block title %}{{ page.title }} · {{ site.name ?? '' }}{% endblock %}
{% block meta %}<meta name="robots" content="noindex">{% endblock %}
{% block body_class %} site--legal{% endblock %}

{% block content %}
  <main class="legal">
    <a class="legal__back" href="/">{{ 'site.back_home'|t }}</a>
    <h1 class="legal__title">{{ page.title }}</h1>
    <div class="legal__content">
      {% if page.content_html %}{{ page.content_html|raw }}{% else %}<p>{{ 'legal.empty'|t }}</p>{% endif %}
    </div>
  </main>
{% endblock %}
